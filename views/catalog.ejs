<%- include('partials/header') %>
<h1>Каталог</h1>
<div class="row">
  <% products.forEach(p => { %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <div class="card-body">
          <h5><%= p.name %></h5>
          <p><%= p.price %> ₽</p>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>