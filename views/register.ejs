<%- include('partials/header') %>

<h1>Регистрация</h1>

<form method="POST" action="/register" class="mt-3" style="max-width:500px">

  <div class="mb-3">
    <label>Имя *</label>
    <input name="name" value="<%= old.name || '' %>" class="form-control">
    <% if (errors.name) { %><div class="text-danger"><%= errors.name %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Фамилия *</label>
    <input name="surname" value="<%= old.surname || '' %>" class="form-control">
    <% if (errors.surname) { %><div class="text-danger"><%= errors.surname %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Отчество</label>
    <input name="patronymic" value="<%= old.patronymic || '' %>" class="form-control">
    <% if (errors.patronymic) { %><div class="text-danger"><%= errors.patronymic %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Логин *</label>
    <input name="login" value="<%= old.login || '' %>" class="form-control">
    <% if (errors.login) { %><div class="text-danger"><%= errors.login %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Email *</label>
    <input name="email" value="<%= old.email || '' %>" class="form-control">
    <% if (errors.email) { %><div class="text-danger"><%= errors.email %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Пароль *</label>
    <input type="password" name="password" class="form-control">
    <% if (errors.password) { %><div class="text-danger"><%= errors.password %></div><% } %>
  </div>

  <div class="mb-3">
    <label>Повтор пароля *</label>
    <input type="password" name="password_repeat" class="form-control">
    <% if (errors.password_repeat) { %><div class="text-danger"><%= errors.password_repeat %></div><% } %>
  </div>

  <div class="mb-3 form-check">
    <input type="checkbox" name="rules" class="form-check-input" id="rules">
    <label class="form-check-label" for="rules">Согласен с правилами *</label>
    <% if (errors.rules) { %><div class="text-danger"><%= errors.rules %></div><% } %>
  </div>

  <button class="btn btn-primary">Зарегистрироваться</button>
</form>

<%- include('partials/footer') %>