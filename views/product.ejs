<%- include('partials/header') %>

<a href="/catalog" class="btn btn-link mb-3 px-0">← Назад в каталог</a>

<div class="row">

  <!-- Фото -->
  <div class="col-md-6 mb-4">
    <img src="/img/products/<%= product.image || 'no-image.jpg' %>"
         class="img-fluid border rounded bg-white"
         style="max-height: 450px; object-fit: contain; width: 100%;"
         alt="<%= product.name %>">
  </div>

  <!-- Информация -->
  <div class="col-md-6">
    <h1><%= product.name %></h1>

    <p class="fs-2 fw-bold text-primary mb-4">
      <%= Number(product.price).toLocaleString('ru-RU') %> ₽
    </p>

    <h5>Характеристики</h5>
    <table class="table table-sm">
      <tr>
        <th style="width: 220px;">Страна-производитель</th>
        <td><%= product.country || '—' %></td>
      </tr>
      <tr>
        <th>Год выпуска</th>
        <td><%= product.year || '—' %></td>
      </tr>
      <tr>
        <th>Модель</th>
        <td><%= product.model || '—' %></td>
      </tr>
      <tr>
        <th>В наличии</th>
        <td><%= product.stock %> шт.</td>
      </tr>
    </table>

    <button class="btn btn-primary btn-lg mt-2">В корзину</button>
  </div>

</div>

<%- include('partials/footer') %>